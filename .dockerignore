# Build context for deploy/Dockerfile. Only src/, pyproject.toml, uv.lock, the two data
# files and the wordlist check are copied; everything else stays out of the context.
.git
.venv
data
!data/company_lexicon.json
!data/wordlist_web2.txt
scripts
deploy
!deploy/container_wordlist.py
*.md
.env
.env.example
__pycache__
**/__pycache__
*.pyc
.DS_Store
# macOS tar writes AppleDouble sidecars that match *.py
._*
# model weights, if any are kept locally
models
research_*
