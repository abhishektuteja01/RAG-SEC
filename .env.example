POSTGRES_USER=rag_sec
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_sec
# POSTGRES_HOST=localhost   # optional, e.g. for an SSH-tunneled or remote Postgres
# POSTGRES_PORT=5432        # optional

# SEC EDGAR requires a real contact email in every request's User-Agent header.
EDGAR_CONTACT_EMAIL=you@example.com

# Google AI Studio key for every current answer-generation path (gemini-3.7-flash /
# gemini-3.1-flash-lite). Read explicitly by scripts/archive/answer_ab_run.py and
# implicitly by ChatGoogleGenerativeAI in src/rag_sec/agent.py. Required.
GOOGLE_API_KEY=your_key_here

# Anthropic API key for Arm 4 Strategy C table summaries (claude-haiku-4-5). Only needed
# to rebuild the variant-C corpus; Strategy A won (ARM4-10), so this is not on any live path.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Langfuse Cloud (Hobby tier) for the Day 10 observability spans. OPTIONAL: with these
# unset, src/rag_sec/tracing.py degrades to a no-op and every path runs unchanged, so no
# script and no CI job needs keys. LANGFUSE_BASE_URL is the v4 name for what v3 called
# LANGFUSE_HOST; use the EU or US host matching wherever the account was created.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Everything below is optional; the defaults are what the published numbers used ────

# Path to a plain-text English wordlist. RETR-11's guard drops a company match whose name is
# an ordinary English word ("visa applications" -> Visa Inc.). Unset, src/rag_sec/company.py
# falls back to /usr/share/dict/words and friends, and on a machine with none of those the
# guard SILENTLY WEAKENS -- a correctness regression with no error. The Docker image ships
# data/wordlist_web2.txt and scripts/checks/container_wordlist.py refuses to serve without it.
# COMPANY_WORDLIST=/usr/share/dict/words

# Forces the torch device instead of src/rag_sec/config.pick_device()'s cuda > mps > cpu.
# `cpu` is the escape hatch from the MPS segfault documented in pick_device(); INFRA-6
# measured mps and cpu score-identical to 2e-6, so this is a speed knob, not an accuracy one.
# The container sets it to cpu.
# RAG_SEC_DEVICE=cpu

# "0" skips the API's boot-time model warm-up (src/rag_sec/api.py). Default on: model
# construction is ~19s and would otherwise land inside whichever request arrives first.
# RAG_SEC_WARM=1

# The two RETR-7/RETR-8 chunking flags (src/rag_sec/chunking.py). BOTH DEFAULT ON AND MUST
# MATCH THE STORED CORPUS. Turning either off makes the packer reproduce a different document
# than the one that was embedded: measured 2026-09-04, default-off replay matched only
# 52,342/99,654 chunks. Only scripts/checks/heading_fix.py should ever flip them.
# RAG_SEC_MULTI_HEADING=1
# RAG_SEC_STRIP_TITLE_FURNITURE=1

# Phase 02 (scripts/pipeline/02_gold_labels.py) inputs. RAW_DATA_DIR is where the raw
# FinQA/ConvFinQA JSON lives; it is not committed and defaults to a data/raw that does not
# exist on this machine (INFRA-15), so the `evidence` leg cannot run without it.
# GOLD_MATCHED_PATH points at the frozen day7_gold_inds_matched_full.json, override-only so a
# restored copy can be used without editing the script.
# RAW_DATA_DIR=data/raw
# GOLD_MATCHED_PATH=data/day7_gold_inds_matched_full.json

# Cross-encoder batch size on the GPU node (scripts/pipeline/hpc/rerank_hpc.py). Default 128;
# 256 is safe on a 32GB V100 — same fp32 math, so scores cannot shift, and an over-large batch
# OOMs in seconds rather than hours in.
# RETR16_BATCH=128

# Kill switch for tracing that leaves the keys in place. Any of 0/false/no/off disables it;
# anything else (including unset) leaves it on, so this only ever needs setting to turn
# tracing OFF. Keys still have to be present for tracing to do anything at all.
# LANGFUSE_TRACING_ENABLED=true
