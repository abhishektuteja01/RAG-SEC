# Copy to .env and fill in. Loaded with `uv run --env-file .env ...` and by docker compose.

# Postgres (docker-compose.yml creates this user and database).
POSTGRES_USER=rag_sec
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_sec
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Google AI Studio key for answer generation (gemini-3.7-flash). Needed by /ask only.
GOOGLE_API_KEY=your_key_here

# The wordlist the company resolver's English-word guard reads. The repo copy is the list
# every number was measured with; rag_sec.company already prefers it when this is unset.
COMPANY_WORDLIST=data/wordlist_web2.txt

# Force the torch device (cuda, mps or cpu) instead of auto-detecting cuda > mps > cpu.
# cpu is the escape hatch if Apple MPS misbehaves; scores are the same either way.
# RAG_SEC_DEVICE=cpu

# Set to 0 to skip the ~19s model warm-up when the API starts.
# RAG_SEC_WARM=1

# Only for scripts/rebuild/corpus.py: SEC EDGAR requires a real contact email.
# EDGAR_CONTACT_EMAIL=you@example.com
